<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="/css/formAdd-Update.css">
    <link rel="stylesheet" href="/assets/fontawesome-web/fontawesome-free-6.7.2-web/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- sidebar -->
        <%- include('sidebar.ejs') %>
        <!-- sidebar -->

        <!-- content -->
        <div class="content-wrapper">   
            <%- include('navbarTop.ejs') %>
            <div class="container-wrapper">
                <div class="main">
                    <ul class="main_heading">
                        <li><a href=""><span>Customer/Add Customer</span></a></li>
                    </ul>
                    <form action="create-customer" method="post" enctype="multipart/form-data">
                        <div class="input-group">
                            <label for="">Full name:</label>
                            <input class="input-text" type="text" name="fullName">
                        </div>
                        <div class="input-group">
                            <label for="">Date:</label>
                            <input type="date" name="dateOfBirth">
                        </div>                        
                        <div class="input-group">
                            <label for="">Sex:</label>
                            <input type="radio" name="sex" value="1" checked="checked">Nam
                            <input type="radio" name="sex" value="0">Nữ
                        </div>
                        <div class="input-group">
                            <label for="">Address:</label>
                            <input class="input-text" type="text" name="address">
                        </div>
                        <div class="input-group">
                            <label for="">Email:</label>
                            <input class="input-text" type="text" name="email">
                        </div>
                        <div class="input-group">
                            <label for="">Phone:</label>
                            <input class="input-text" type="text" name="phone">
                        </div>
                        <div class="input-group">
                            <label for="">Avatar:</label>
                            <input type="file" name="avatar" id="">
                        </div>        
                        <button type="submit">Add</button>
                    </form>
                </div>
            </div>                
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
    <script src="/js/home.js"></script>
</body>
</html>