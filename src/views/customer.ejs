<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="/assets/fontawesome-web/fontawesome-free-6.7.2-web/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- sidebar -->
        <%- include('sidebar.ejs') %>
        <!-- sidebar -->

        <!-- content -->
        <div class="content-wrapper">   
            <%- include('navbarTop.ejs') %>
            <div class="container-wrapper">
                <div class="main">
                    <ul class="main_heading">
                        <li><a href=""><span>Customer/</span></a></li>
                    </ul>
                    <a href="">Add new Customer</a>                       
                    <table>
                        <tr>
                            <th>ID</th>
                            <th>NAME</th>
                            <th>AGE</th>
                            <th>SEX</th>
                            <th>ADDRESS</th>
                            <th>EMAIL</th>
                            <th>PHONE</th>
                            <th>ACCTION</th>
                        </tr>
                        <% data.forEach((customer) => { %>
                        <tr>
                            <td><%= customer.id %></td>
                            <td><%= customer.fullName %></td>
                            <% var d = new Date(customer.dateOfBirth); var day=(d.getUTCDate() + 1).toString().padStart(2,0); var month=(d.getUTCMonth() + 1).toString().padStart(2,0); var year=d.getUTCFullYear(); var dateString=day+"/"+month+"/"+year %>
                            <td><%= dateString %></td>
                            <td>
                                <% if(customer.sex == 1){ %>
                                    Nam
                                <% } else { %>
                                    Nữ    
                                =<% } %>
                            </td>
                            <td><%= customer.address %></td>
                            <td><%= customer.email %></td>
                            <td><%= customer.phone %></td>
                            <td><a href=""><i class="fa-solid fa-pen-to-square"></i></a> <a href=""><i class="fa-solid fa-trash"></i></a></td>
                        </tr>    
                        <% }) %>
                    </table>
                </div>
            </div>                
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
    <script src="/js/home.js"></script>
</body>
</html>