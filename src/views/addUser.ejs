<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="/css/formAdd-Update.css">
    <link rel="stylesheet" href="/assets/fontawesome-web/fontawesome-free-6.7.2-web/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- sidebar -->
        <%- include('sidebar.ejs') %>
        <!-- sidebar -->

        <!-- content -->
        <div class="content-wrapper">   
            <%- include('navbarTop.ejs') %>
            <div class="container-wrapper">
                <div class="main">
                    <ul class="main_heading">
                        <li><a href=""><span>Nhân viên/Thêm mới nhân viên</span></a></li>
                    </ul>
                    <form action="create-user" method="post" enctype="multipart/form-data">
                        <div class="input-group">
                            <label for="">Họ tên:</label>
                            <input class="input-text" type="text" name="fullName">
                        </div>
                        <div class="input-group">
                            <label for="">Ngày sinh:</label>
                            <input type="date" name="dateOfBirth">
                        </div>                        
                        <div class="input-group">
                            <label for="">Giới tính:</label>
                            <input type="radio" name="sex" value="1" checked="checked">Nam
                            <input type="radio" name="sex" value="0">Nữ
                        </div>
                        <div class="input-group">
                            <label for="">Địa chỉ:</label>
                            <input class="input-text" type="text" name="address">
                        </div>
                        <div class="input-group">
                            <label for="">Email:</label>
                            <input class="input-text" type="text" name="email">
                        </div>
                        <div class="input-group">
                            <label for="">Số điện thoại:</label>
                            <input class="input-text" type="text" name="phone">
                        </div>
                        <div class="input-group">
                            <label for="">Chức vụ:</label>
                            <select name="user_role" id="">
                                <% data.forEach((role) => { %>
                                    <option value="<%= role.id %>"><%= role.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="input-group">
                            <label for="">Tên đăng nhập:</label>
                            <input class="input-text" type="text" name="username">
                        </div>
                        <div class="input-group">
                            <label for="">Mật khẩu:</label>
                            <input class="input-text" type="text" name="password">
                        </div>
                        <div class="input-group">
                            <label for="">Hình ảnh:</label>
                            <input type="file" name="avatar" id="imgInput">
                        </div>
                        <div class="input-group">
                            <img id="imgPreview" src="/images/avtUsers/default_avt.jpg" alt="">         
                        </div>          
                        <button type="submit">Thêm mới</button>
                    </form>
                </div>
            </div>                
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
    <script src="/js/home.js"></script>
    <script src="/js/previewImage.js"></script>
</body>
</html>