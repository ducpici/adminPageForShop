<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- sidebar -->
        <%- include('sidebar.ejs') %>
        <!-- sidebar -->

        <!-- content -->
        <div class="content-wrapper">   
            <%- include('navbarTop.ejs') %>
            <div class="container-wrapper">
                <div class="main">
                    <ul class="main_heading">
                        <li><a href=""><span>Sản phẩm/</span></a></li>
                    </ul>
                    <a class="addNew" href="add-product">Thêm mới sản phẩm</a>         
                    <table>
                        <tr>
                            <th>#</th>
                            <th>Mã sản phẩm</th>
                            <th>Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Loại sản phẩm</th>
                            <th>Thương hiệu</th>
                            <th>Mô tả sản phẩm</th>
                            <th>Giá</th>
                            <th>Số lượng</th>
                            <th>Chức năng</th>
                        </tr>
                        <% var count=0; %>
                        <% data.forEach((product) => { count++ %>
                        <tr>
                            <td><%= count %></td>
                            <td><%= product.product_id %></td>
                            <td>
                                <% if(product.img == 'none') { %>
                                    <img class="img-product" src="/images/avtUsers/default_imgProduct.jpg %>" alt="">    
                                <% } else { %>         
                                    <img class="img-product" src="/images/avtUsers/<%= product.img %>" alt="">
                                <% } %>
                            <td><%= product.product_name %></td>
                            <td><%= product.product_type_name %></td>
                            
                            <td><%= product.brand_name %></td>
                            <!-- <td><%= product.description %></td> -->
                            <td><%= product.description %></td>
                            <td><%= product.price %></td>
                            <td><%= product.quantity %></td>
                            <td class="actions"><a class="editIcon actionIcon" href="edit-product/<%= product.product_id %>"><i class="fa-solid fa-pen-to-square"></i></a> <a class="deleteIcon actionIcon" href="delete-product/<%= product.product_id %>"><i class="fa-solid fa-trash"></i></a></td>
                        </tr>    
                        <% }) %>
                    </table>
                </div>
            </div>                
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
    <script src="/js/home.js"></script>
</body>
</html>