<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="/css/formAdd-Update.css">
    <link rel="stylesheet" href="/assets/fontawesome-web/fontawesome-free-6.7.2-web/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- sidebar -->
        <%- include('sidebar.ejs') %>
        <!-- sidebar -->

        <!-- content -->
        <div class="content-wrapper">   
            <%- include('navbarTop.ejs') %>
            <div class="container-wrapper">
                <div class="main">
                    <ul class="main_heading">
                        <li><a href=""><span>Loại sản phẩm/Cập nhật Loại sản phẩm</span></a></li>
                    </ul>
                    <form action="update-product_type/<%= product_type.id %>" method="post">
                        <div class="input-group">
                            <label for="">Tên loại sản phẩm:</label>
                            <input class="input-text" type="text" name="product_type_name" value="<%= product_type.product_type_name %>">
                        </div>       
                        <button type="submit">Cập nhật</button>
                    </form>
                </div>
            </div>                
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
    <script src="/js/home.js"></script>
</body>
</html>