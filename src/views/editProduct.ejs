<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="/css/formAdd-Update.css">
    <link rel="stylesheet" href="/assets/fontawesome-web/fontawesome-free-6.7.2-web/css/all.min.css">
    <!-- <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"> -->
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- sidebar -->
        <%- include('sidebar.ejs') %>
        <!-- sidebar -->

        <!-- content -->
        <div class="content-wrapper">   
            <%- include('navbarTop.ejs') %>
            <div class="container-wrapper">
                <div class="main">
                    <ul class="main_heading">
                        <li><a href=""><span>Sản phẩm/Chỉnh sửa sản phẩm</span></a></li>
                    </ul>
                    <!-- <form action="/update-product/<%= product.id %>" method="post"> -->
                    <form id="updateForm">
                        <div class="input-group" style="display: none;">
                            <label for="">Mã sản phẩm:</label>
                            <input class="input-text" type="text" id="productId" value="<%= product.id %>">
                        </div>
                        <div class="input-group">
                            <label for="">Tên sản phẩm:</label>
                            <input class="input-text" type="text" name="productName" value="<%= product.product_name %>">
                        </div>
                        <div class="input-group">
                            <label for="">Loại sản phẩm:</label>
                            <select name="type" id="">
                                <% types.forEach((type) => { %>
                                    <option value="<%= type.id %>" <%= type.id === product.product_type_id ? 'selected' : '' %>><%= type.product_type_name %></option>
                                <% }) %>
                            </select>
                        </div>                        
                        <div class="input-group">
                            <label for="">Nhà cung cấp:</label>
                            <select name="brand" id="">
                                <% brands.forEach((brand) => { %>
                                    <option value="<%= brand.id %>" <%= brand.id === product.brand_id ? 'selected' : '' %>><%= brand.brand_name %></option>
                                <% }) %>
                            </select>                            
                        </div>
                        <div class="input-group">
                            <label for="">Mô tả:</label>
                            <input class="input-text" type="text" name="description" value="<%= product.description %>">
                        </div>
                        <div class="input-group">
                            <label for="">Giá:</label>
                            <input class="input-text" type="text" name="price" value="<%= product.price %>">
                        </div>
                        <div class="input-group">
                            <label for="">Số lượng:</label>
                            <input class="input-text" type="text" name="quantity" value="<%= product.quantity %>">
                        </div>
                        <div class="input-group">
                            <label for="">Hình ảnh:</label>
                            <input type="file" name="avatar" id="imgInput"> 
                            <input type="hidden" id="oldImage" value="<%= product.img %>">                      
                        </div>  
                        <div class="input-group">
                            <% if(product.img == 'none') { %>
                                <img id="imgPreview" src="/images/avtUsers/default_imgProduct.jpg %>" alt="">    
                            <% } else { %>         
                                <img id="imgPreview" src="/images/avtUsers/<%= product.img %>" alt="">
                            <% } %>
                        </div>             
                        <button type="submit">Cập nhật</button>
                    </form>
                </div>
            </div>                
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
    <script src="/js/home.js"></script>
    <script>
        document.getElementById("imgInput").addEventListener("change", function(event) {
            const file = event.target.files[0]; // Lấy file được chọn
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById("imgPreview").src = e.target.result; // Gán ảnh preview
                };
                reader.readAsDataURL(file); // Đọc file ảnh
            }
        });
        document.getElementById("updateForm").addEventListener("submit", function(event) {
        event.preventDefault();
    
        const formData = new FormData();
        const fileInput = document.getElementById("imgInput");
        const input = document.forms["updateForm"];
        
        if (fileInput.files.length > 0) {
            formData.append("avatar", fileInput.files[0]); // Nếu có ảnh mới, gửi ảnh mới
        } else {
            formData.append("avatar", document.getElementById("oldImage").value); // Không chọn ảnh => giữ ảnh cũ
        }
    
        // Gửi formData lên server
        const product_id = document.getElementById('productId')
        formData.append("productName", input["productName"].value);
        formData.append("type", input["type"].value);
        formData.append("brand", input["brand"].value);
        formData.append("description", input["description"].value);
        formData.append("price", input["price"].value);
        formData.append("quantity", input["quantity"].value);
        formData.append("id", product_id.value)
        fetch(`/update-product/${product_id.value}`, {
            method: "POST",
            body: formData,
        })
        .then(response => response.json())
        .then(data => {
            if(data.success){
                alert("Cập nhật thành công!")
                window.location.href = data.redirect;
            }else {
                alert("Lỗi: " + data.error);
            }
        })
        .catch(error => console.error("Lỗi:", error));
    });
    </script>
</body>
</html>