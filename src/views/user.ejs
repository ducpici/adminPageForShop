<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="/assets/fontawesome-web/fontawesome-free-6.7.2-web/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- sidebar -->
        <%- include('sidebar.ejs') %>
        <!-- sidebar -->

        <!-- content -->
        <div class="content-wrapper">   
            <%- include('navbarTop.ejs') %>
            <div class="container-wrapper">
                <div class="main">
                    <ul class="main_heading">
                        <li><a href=""><span>Nhân viên/</span></a></li>
                    </ul>
                    <a class="addNew" href="add-user">Thêm mới</a>                       
                    <table>
                        <tr>
                            <th>#</th>
                            <th>Mã nhân viên</th>
                            <th>Họ tên nhân viên</th>
                            <th>Ngày sinh</th>
                            <th>Giới tính</th>
                            <th>Địa chỉ</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Chức vụ</th>
                            <th>Chức năng</th>
                        </tr>
                        <% var count=0; %>
                        <% data.forEach((user) => { count++ %>
                        <tr>
                            <td><%= count %></td>
                            <td><%= user.id %></td>
                            <td><%= user.fullName %></td>
                            <% var d = new Date(user.dateOfBirth); var day=(d.getUTCDate() + 1).toString().padStart(2,0); var month=(d.getUTCMonth() + 1).toString().padStart(2,0); var year=d.getUTCFullYear(); var dateString=day+"/"+month+"/"+year %>
                            <td><%= dateString %></td>
                            <td>
                                <% if(user.sex == 1){ %>
                                    Nam
                                <% } else { %>
                                    Nữ    
                                <% } %>
                            </td>
                            <td><%= user.address %></td>
                            <td><%= user.email %></td>
                            <td><%= user.phone %></td>
                            <td><%= user.name %></td>
                            <td class="actions"><a class="editIcon actionIcon" href="edit-user/<%= user.id %>"><i class="fa-solid fa-pen-to-square"></i></a> <a class="deleteIcon actionIcon" href="delete-user/<%= user.id %>"><i class="fa-solid fa-trash"></i></a></td>
                        </tr>    
                        <% }) %>
                    </table>
                </div>
            </div>                
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
    <!-- <script src="/js/home.js"></script> -->
</body>
</html>