<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="/assets/fontawesome-web/fontawesome-free-6.7.2-web/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- sidebar -->
        <%- include('sidebar.ejs') %>
        <!-- sidebar -->

        <!-- content -->
        <div class="content-wrapper">   
            <%- include('navbarTop.ejs') %>
            <div class="container-wrapper">
                <div class="main">
                    <ul class="main_heading">
                        <li><a href=""><span>Nhà cung cấp/</span></a></li>
                    </ul>
                    <a class="addNew" href="add-brand">Thêm mới</a>                       
                    <table>
                        <tr>
                            <th>#</th>
                            <th>Mã nhà cung cấp</th>
                            <th>Tên nhà cung cấp</th>
                            <th>Chức năng</th>
                        </tr>
                        <% var count=0; %>
                        <% data.forEach((brand) => { count++ %>
                        <tr>
                            <td><%= count %></td>
                            <td><%= brand.id %></td>
                            <td><%= brand.brand_name %></td>         
                            <td class="actions"><a class="editIcon actionIcon" href="edit-brand/<%= brand.id %>"><i class="fa-solid fa-pen-to-square"></i></a> <a class="deleteIcon actionIcon" href="delete-brand/<%= brand.id %>"><i class="fa-solid fa-trash"></i></a></td>
                        </tr>    
                        <% }) %>
                    </table>
                </div>
            </div>                
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
    <script src="/js/home.js"></script>
</body>
</html>