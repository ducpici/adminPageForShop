<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="/css/formAdd-Update.css">
    <link rel="stylesheet" href="/assets/fontawesome-web/fontawesome-free-6.7.2-web/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Document</title>
</head>
<body>
    <div class="wrapper">
        <!-- sidebar -->
        <%- include('sidebar.ejs') %>
        <!-- sidebar -->

        <!-- content -->
        <div class="content-wrapper">   
            <%- include('navbarTop.ejs') %>
            <div class="container-wrapper">
                <div class="main">
                    <ul class="main_heading">
                        <li><a href=""><span>Nhân viên/Chỉnh sửa nhân viên</span></a></li>
                    </ul>
                    <form action="/update-user/<%= user.id %>" method="post" enctype="multipart/form-data">
                        <div class="input-group">
                            <label for="">Họ tên:</label>
                            <input class="input-text" type="text" name="fullName" value="<%= user.fullName %>">
                        </div>
                        <div class="input-group">
                            <label for="">Ngày sinh:</label>
                            <% var d = new Date(user.dateOfBirth); var day=(d.getUTCDate() + 1).toString().padStart(2,0); var month=(d.getUTCMonth() + 1).toString().padStart(2,0); var year=d.getUTCFullYear(); var dateString=year+"-"+month+"-"+day%>
                            <input type="date" name="dateOfBirth" value="<%= dateString %>">
                        </div>                        
                        <div class="input-group">
                            <label for="">Giới tính:</label>
                            <input type="radio" name="sex" value="1" <%= user.sex === 1 ? 'checked' : '' %>>Nam
                            <input type="radio" name="sex" value="0" <%= user.sex === 0 ? 'checked' : '' %>>Nữ
                        </div>
                        <div class="input-group">
                            <label for="">Địa chỉ:</label>
                            <input class="input-text" type="text" name="address" value="<%= user.address %>">
                        </div>
                        <div class="input-group">
                            <label for="">Email:</label>
                            <input class="input-text" type="text" name="email" value="<%= user.email %>">
                        </div>
                        <div class="input-group">
                            <label for="">Số điện thoại:</label>
                            <input class="input-text" type="text" name="phone" value="<%= user.phone %>">
                        </div>
                        <div class="input-group">
                            <label for="">Chức vụ:</label>
                            <select name="user_role" id="">
                                <% data.forEach((role) => { %>
                                    <option value="<%= role.id %>" <%= role.id === user.role_id ? 'selected' : '' %>><%= role.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="input-group">
                            <label for="">Tên đăng nhập:</label>
                            <input class="input-text" type="text" name="username" value="<%= user.username %>">
                        </div>
                        <div class="input-group">
                            <label for="">Mật khẩu:</label>
                            <input class="input-text" type="text" name="password" value="<%= user.password %>">
                        </div>
                        <div class="input-group">
                            <label for="">Hình ảnh:</label>
                            <input type="file" name="avatar" id="imgInput">                       
                        </div>  
                        <div class="input-group">
                            <% if(user.avtUser == '') { %>
                                <img id="imgPreview" src="/images/avtUsers/default_avt.jpg %>" alt="">    
                            <% } else { %>         
                                <img id="imgPreview" src="/images/avtUsers/<%= user.avtUser %>" alt="">
                            <% } %>
                        </div>      
                        <button type="submit">Cập nhật</button>
                    </form>
                </div>
            </div>                
        </div>
        <!-- content -->

        <!-- footer -->
        <footer class="footer">

        </footer>
        <!-- footer -->
    </div>
    <script src="/js/home.js"></script>
    <script src="/js/previewImage.js"></script>
</body>
</html>